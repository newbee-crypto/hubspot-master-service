# =============================================================================
# HubSpot Master Service — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials.
# =============================================================================

# --- App Metadata ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql://hubspot_user:hubspot_pass@localhost:5432/hubspot_service
DATABASE_POOL_SIZE=10

# --- HubSpot API ---
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_API_VERSION=v3
HUBSPOT_REQUEST_TIMEOUT=30

# --- HubSpot Rate Limiting ---
HUBSPOT_BURST_LIMIT=100
HUBSPOT_DAILY_LIMIT=250000
HUBSPOT_RATE_LIMIT_WINDOW_SECONDS=10
HUBSPOT_RATE_LIMIT_RETRY_AFTER_FALLBACK=10

# --- HubSpot Pagination ---
HUBSPOT_DEFAULT_PAGE_SIZE=100
HUBSPOT_MAX_PAGE_SIZE=100

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hubspot-data
MINIO_SECURE=false

# --- Resilience ---
EXTERNAL_CALL_MAX_RETRIES=3
EXTERNAL_CALL_RETRY_DELAYS=1,2,4
EXTERNAL_CALL_JITTER=0.5
DLQ_PAYLOAD_MAX_BYTES=10000

# --- HMAC Authentication ---
HMAC_ENABLED=true
HMAC_SECRET_KEY_CORE=change-me-coordinator-secret-key-min-32-chars!!
HMAC_SECRET_KEY_ENGINEER=change-me-engineer-secret-key-min-32-chars!!!!
HMAC_SIGNATURE_MAX_AGE=300
HMAC_CLIENT_CONFIG={}

# --- Heartbeat ---
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_STALE_TIMEOUT_MINUTES=5

# --- Encryption ---
ENCRYPTION_KEY=

# --- Data Storage ---
DATA_DIR=./data
